# Copy to .env and fill in from your Supabase project settings.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Comma-separated allowed origins for CORS.
CORS_ORIGINS=http://localhost:3000
# Session-pooler connection string (Settings -> Database). Used for runner
# claim/callback endpoints and migration application.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Shared secret the runner presents on claim/callback calls.
RUNNER_SHARED_SECRET=change-me
# US-16.8: the deployment Build Mill files its own unhandled errors against.
# Must be flagged is_self_monitoring and have issue reporting enabled. Unset
# disables self-reporting silently.
SELF_REPORT_DEPLOYMENT_ID=

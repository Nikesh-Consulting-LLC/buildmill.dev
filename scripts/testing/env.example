# Copy to scripts/testing/.env and fill in what you have.
#
# Nothing here is required. With none of it set, the suite still runs its
# unauthenticated half — the auth boundary of all 227 operations — against
# whatever API_BASE_URL points at. Each credential you add switches on the
# tests that need it; the runner prints what stayed skipped and why.
#
# The .env you create is git-ignored. Never commit a real token.

# ---------------------------------------------------------------------------
# Target
# ---------------------------------------------------------------------------
# Local api:  http://localhost:8000     (npm run api, from the repo root)
# UAT:        https://uat-api.buildmill.dev
# Production: https://api.buildmill.dev   <- read-only credentials only, please
API_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Sessions — the suite exchanges these for an access token at start-up
# ---------------------------------------------------------------------------
# The Supabase project the api verifies JWTs against. Must be the SAME project
# the target api is configured with, or every token will be rejected as forged.
# dev = build-mill-dev (nncquokoblcfcqyajzmk), prod = Software-Factory.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# An ordinary org member.
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# A platform admin — without this, the 41 /admin operations are only tested
# for their auth boundary, never for what they return.
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=

# Already have tokens? These skip the sign-in entirely (they expire in an hour).
# TEST_ACCESS_TOKEN=
# TEST_ADMIN_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Worker credential — for /worker/* and the factory git remote
# ---------------------------------------------------------------------------
TEST_WORKER_TOKEN=

# ---------------------------------------------------------------------------
# Ids the read-only tests address. Each one gates only its own block, so
# filling in two of them switches on two blocks and leaves the rest skipped.
# ---------------------------------------------------------------------------
TEST_ORG_ID=
TEST_PROJECT_ID=
TEST_DEPLOYMENT_ID=
TEST_ISSUE_ID=
TEST_RELEASE_ID=
TEST_SERVER_ID=
TEST_AGENT_HOST_ID=
TEST_WORKER_ID=

# ---------------------------------------------------------------------------
# Danger
# ---------------------------------------------------------------------------
# Off unless you mean it. On, the suite creates and deletes orgs, presets and
# env vars, provisions a member, dispatches work and touches real servers.
# Point it at a disposable environment, never at production.
# ALLOW_MUTATIONS=1

# Per-request timeout in ms.
# REQUEST_TIMEOUT_MS=20000

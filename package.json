{
  "name": "software-factory",
  "version": "0.1.0",
  "private": true,
  "description": "Software Factory \u2014 AI-driven software delivery pipeline with a human manager in the loop.",
  "workspaces": [
    "apps/web",
    "apps/public"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "build": "npm run build --workspace apps/web",
    "start": "npm run start --workspace apps/web",
    "public": "npm run start --workspace public",
    "lint": "npm run lint --workspace apps/web",
    "api": "apps\\api\\.venv\\Scripts\\python -m uvicorn app.main:app --reload --reload-dir apps/api/app --app-dir apps/api --port 8000",
    "test:api": "cd apps/api && .venv\\Scripts\\python -m pytest",
    "test:api:full": "cd apps/api && .venv\\Scripts\\python -m pytest --full",
    "test:runner": "cd apps/runner && python -m pytest",
    "test:web": "node --experimental-strip-types --test \"apps/web/src/**/*.test.ts\""
  },
  "engines": {
    "node": ">=20"
  }
}
